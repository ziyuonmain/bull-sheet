{
  "name": "bull-sheet",
  "version": "1.5.1",
  "description": "BullSheet — Zero-BS Browser Darts Scoreboard and caller",
  "type": "module",
  "scripts": {
    "start": "node dev_server.js",
    "dev": "node dev_server.js",
    "test": "node --test tests/unit/**/*.test.js && playwright test",
